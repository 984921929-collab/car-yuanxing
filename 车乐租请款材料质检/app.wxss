page {
  min-height: 100vh;
  background: #f7f8fb;
  color: #17233d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
}

.safe-bottom {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border: 1rpx solid #edf0f6;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 35, 61, 0.05);
}

.primary-btn {
  height: 92rpx;
  border-radius: 8rpx;
  background: #1f5eff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost-btn {
  height: 80rpx;
  border: 1rpx solid #d8deea;
  border-radius: 8rpx;
  color: #1f5eff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.muted {
  color: #7c879c;
}

.tag {
  min-height: 48rpx;
  padding: 10rpx 16rpx;
  border-radius: 6rpx;
  background: #eef4ff;
  color: #1f5eff;
  font-size: 24rpx;
  display: inline-flex;
  align-items: center;
}

.danger {
  color: #e55a3c;
}
