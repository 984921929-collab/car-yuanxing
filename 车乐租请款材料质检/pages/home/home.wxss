.top-band {
  min-height: 360rpx;
  padding: 36rpx 32rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #0b43d9 0%, #1f5eff 58%, #6bd6ff 100%);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  opacity: 0.76;
}

.headline {
  width: 520rpx;
  margin-top: 18rpx;
  font-size: 48rpx;
  line-height: 1.16;
  font-weight: 800;
  letter-spacing: 0;
}

.subline {
  width: 560rpx;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.86;
}

.start-btn {
  width: 208rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1f5eff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-head {
  margin: 34rpx 0 20rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
}

.section-meta {
  color: #7c879c;
  font-size: 24rpx;
}

.group-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.group-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.group-title {
  flex: 1;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
}

.group-desc {
  margin-top: 12rpx;
  color: #7c879c;
  font-size: 24rpx;
}

.progress {
  height: 12rpx;
  margin-top: 26rpx;
  border-radius: 6rpx;
  background: #edf1f7;
  overflow: hidden;
}

.progress-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: #1f5eff;
}

.member-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-stack {
  display: flex;
  align-items: center;
}

.avatar {
  width: 52rpx;
  height: 52rpx;
  margin-right: -10rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #e8f0ff;
  color: #1f5eff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.join-state {
  color: #1f5eff;
  font-size: 26rpx;
  font-weight: 700;
}

.empty {
  padding: 44rpx 32rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc {
  margin: 16rpx 0 32rpx;
  color: #7c879c;
  font-size: 26rpx;
  line-height: 1.5;
}
