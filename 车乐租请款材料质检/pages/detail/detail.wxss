.detail-page {
  padding-bottom: 160rpx;
}

.detail-hero {
  padding: 32rpx;
  background: #ffffff;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-kicker {
  color: #1f5eff;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 900;
}

.quota {
  min-width: 112rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #eef4ff;
  color: #1f5eff;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meter {
  height: 14rpx;
  margin-top: 34rpx;
  border-radius: 7rpx;
  background: #edf1f7;
  overflow: hidden;
}

.meter-fill {
  height: 14rpx;
  border-radius: 7rpx;
  background: #1f5eff;
}

.hero-foot {
  margin-top: 22rpx;
  color: #7c879c;
  font-size: 25rpx;
  display: flex;
  justify-content: space-between;
}

.section {
  margin-top: 20rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
}

.section-count,
.empty-line {
  color: #7c879c;
  font-size: 24rpx;
}

.rule-list {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.rule {
  max-width: 100%;
}

.member {
  min-height: 94rpx;
  padding-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #1f5eff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-meta {
  margin-top: 8rpx;
  color: #7c879c;
  font-size: 23rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf0f6;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  gap: 18rpx;
}

.bottom-bar .ghost-btn {
  flex: 1;
}

.bottom-bar .primary-btn {
  flex: 1.25;
}

.share-btn,
.join-btn {
  height: 88rpx;
}

.disabled {
  background: #aab2c0;
}

.join-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 0 42rpx;
  background: rgba(11, 19, 36, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
}

.join-modal {
  width: 100%;
  padding: 34rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 900;
}

.modal-desc {
  margin-top: 12rpx;
  color: #7c879c;
  font-size: 25rpx;
}

.nick-input {
  width: 100%;
  height: 86rpx;
  margin-top: 28rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe5ef;
  border-radius: 8rpx;
  background: #fbfcff;
  font-size: 28rpx;
}

.modal-actions {
  margin-top: 26rpx;
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 82rpx;
}

.missing {
  margin-top: 120rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.missing-title {
  font-size: 34rpx;
  font-weight: 900;
}

.missing-desc {
  margin: 16rpx 0 30rpx;
  color: #7c879c;
  font-size: 26rpx;
  line-height: 1.5;
}
