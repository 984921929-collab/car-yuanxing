<view class="page detail-page safe-bottom" wx:if="{{group}}">
  <view class="detail-hero card">
    <view class="hero-top">
      <view>
        <view class="hero-kicker">GROUP DETAIL</view>
        <view class="hero-title">{{group.title}}</view>
      </view>
      <view class="quota">{{group.members.length}}/{{group.limit}}</view>
    </view>
    <view class="meter">
      <view class="meter-fill" style="width: {{percent}}%;"></view>
    </view>
    <view class="hero-foot">
      <text>团长 {{group.owner}}</text>
      <text>{{full ? '已满员' : '报名中'}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">限制条件</view>
    <view class="rule-list" wx:if="{{rules.length}}">
      <view wx:for="{{rules}}" wx:key="*this" class="tag rule">{{item}}</view>
    </view>
    <view wx:else class="empty-line">暂无额外限制</view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view class="section-title">已加入</view>
      <view class="section-count">{{group.members.length}} 人</view>
    </view>
    <view class="member" wx:for="{{members}}" wx:key="id">
      <view class="member-avatar">{{item.initial}}</view>
      <view class="member-info">
        <view class="member-name">{{item.name}}</view>
        <view class="member-meta">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="ghost-btn share-btn" open-type="share">转发到微信群</button>
    <button class="primary-btn join-btn {{full ? 'disabled' : ''}}" bindtap="openJoin">{{full ? '已满员' : '立即加入'}}</button>
  </view>

  <view class="join-mask" wx:if="{{showJoin}}">
    <view class="join-modal card">
      <view class="modal-title">填写加入昵称</view>
      <view class="modal-desc">可填写微信昵称或你在群里的昵称。</view>
      <input class="nick-input" type="nickname" value="{{nickname}}" bindinput="onNicknameInput" placeholder="请输入昵称" />
      <view class="modal-actions">
        <button class="ghost-btn modal-btn" bindtap="closeJoin">取消</button>
        <button class="primary-btn modal-btn" bindtap="confirmJoin">确认加入</button>
      </view>
    </view>
  </view>
</view>

<view class="page" wx:else>
  <view class="missing card">
    <view class="missing-title">没有找到这个团</view>
    <view class="missing-desc">可能是本地演示数据不存在。上线后这里会从云端读取分享卡片对应的开团。</view>
    <button class="primary-btn" bindtap="goHome">返回首页</button>
  </view>
</view>
