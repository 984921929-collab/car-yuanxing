.create-page {
  padding-bottom: 150rpx;
}

.summary {
  padding: 32rpx;
  color: #ffffff;
  background: #1f5eff;
}

.summary-kicker {
  font-size: 22rpx;
  font-weight: 800;
  opacity: 0.75;
}

.summary-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.summary-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
  opacity: 0.86;
}

.form {
  margin-top: 22rpx;
  padding: 28rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  margin-bottom: 14rpx;
  color: #596579;
  font-size: 24rpx;
  font-weight: 700;
}

input,
textarea {
  width: 100%;
  min-height: 82rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe5ef;
  border-radius: 8rpx;
  background: #fbfcff;
  color: #17233d;
  font-size: 28rpx;
}

textarea {
  height: 176rpx;
  padding-top: 20rpx;
  line-height: 1.45;
}

.two-col {
  display: flex;
  gap: 18rpx;
}

.two-col .field {
  flex: 1;
  min-width: 0;
}

.segmented {
  height: 78rpx;
  padding: 6rpx;
  border: 1rpx solid #dfe5ef;
  border-radius: 8rpx;
  background: #f3f6fb;
  display: flex;
  gap: 6rpx;
}

.segment {
  flex: 1;
  border-radius: 6rpx;
  color: #596579;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.segment.active {
  background: #ffffff;
  color: #1f5eff;
  box-shadow: 0 4rpx 12rpx rgba(31, 94, 255, 0.12);
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf0f6;
  background: rgba(255, 255, 255, 0.96);
}
